{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-chat",
  "small_model": "deepseek/deepseek-chat",
  "enabled_providers": ["deepseek"],
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "snapshot": false,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      ".pnpm-store/**",
      ".yarn/**",
      ".npm/**",
      ".cache/**",
      "dist/**",
      "build/**",
      ".next/**",
      ".nuxt/**",
      ".output/**",
      "coverage/**",
      "target/**",
      "vendor/**",
      ".venv/**",
      "venv/**",
      "__pycache__/**",
      "*.sqlite",
      "*.sqlite3",
      "*.db",
      "*.duckdb",
      "*.parquet",
      "*.arrow",
      "*.feather",
      "*.csv",
      "*.tsv",
      "*.xlsx",
      "*.bin",
      "*.onnx",
      "*.pt",
      "*.pth",
      "*.ckpt",
      "*.safetensors",
      "*.log",
      "*.zip",
      "*.tar",
      "*.tar.gz",
      "*.gz",
      "*.7z",
      "*.mp4",
      "*.mov",
      "*.mkv",
      "*.png",
      "*.jpg",
      "*.jpeg",
      "*.gif",
      "*.webp",
      "*.pdf"
    ]
  },
  "server": {
    "port": 4189
  },
  "provider": {
    "deepseek": {
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
        "apiKey": "{env:DEEPSEEK_API_KEY}",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    }
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-chat",
  "small_model": "deepseek/deepseek-chat",
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      ".pnpm-store/**",
      ".yarn/**",
      ".npm/**",
      ".cache/**",
      "dist/**",
      "build/**",
      ".next/**",
      ".nuxt/**",
      ".output/**",
      "coverage/**",
      "target/**",
      "vendor/**",
      ".venv/**",
      "venv/**",
      "__pycache__/**",
      "*.log",
      "*.zip",
      "*.tar",
      "*.tar.gz",
      "*.gz",
      "*.7z",
      "*.mp4",
      "*.mov",
      "*.mkv",
      "*.png",
      "*.jpg",
      "*.jpeg",
      "*.gif",
      "*.webp",
      "*.pdf"
    ]
  },
  "server": {
    "port": 4189
  },
  "provider": {
    "deepseek": {
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      }
    }
  }
}
